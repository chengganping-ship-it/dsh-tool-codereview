    "security-scan",
    "owasp",
    "sarif",
    "static-analysis",
    "dependency-audit",
    "performance",
    "auto-fix",
    "diff-preview",
    "architecture-review",
    "test-coverage",
    "api-docs",
    "style-check",
    "code-smell",
    "typescript-strict",
    "incremental-analysis",
    "breaking-change",
    "ai-agent",
