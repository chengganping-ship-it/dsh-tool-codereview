{
  "name": "dsh-tool-codereview",
  "version": "1.1.0",
  "description": "Enterprise Code Review & Security Scan plugin for DeepSeek Harness - 782 tools, Agent Observability Blind Spot Deep, Tool Rate Limit Bypass Expert, Agent Session Hijack Deep, Tool Output Encoding Expert, Agent Goal Inertia Deep, Tool Permission Shadow Expert, Agent Context Eviction Deep, Tool Execution Delay Expert"",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-codereview.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "code-review",
    "security-scan",
    "owasp",
    "sarif",
    "static-analysis",
    "dependency-audit",
    "performance",
    "auto-fix",
    "diff-preview",
    "architecture-review",
    "test-coverage",
    "api-docs",
    "style-check",
    "code-smell",
    "typescript-strict",
    "incremental-analysis",
    "breaking-change",
    "ai-agent",
    "sast",
    "devsecops"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
