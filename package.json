{
  "name": "dsh-tool-codereview",
  "version": "0.4.0",
  "description": "Enterprise Code Review & Security Scan plugin for DeepSeek Harness - 10 tools, SARIF output, OWASP Top 10, Architecture Review, Test Coverage",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-codereview.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "code-review",
    "security-scan",
    "owasp",
    "sarif",
    "static-analysis",
    "dependency-audit",
    "performance",
    "auto-fix",
    "architecture-review",
    "test-coverage",
    "api-docs",
    "style-check",
    "ai-agent",
    "sast",
    "devsecops"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
